<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>NYS Fair Match</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Holtwood+One+SC&family=Luckiest+Guy&family=Rowdies:wght@300;400;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="css/styles.css?v=15" />
</head>
<body>

<div id="app">

  <!-- START SCREEN (disabled for now — game boots straight into play) -->
  <div id="screen-start" class="screen-outer hidden">
    <div class="screen">
      <div class="start-card">
        <img class="logo-img" src="assets/img/logo.svg" alt="THE FAIR" />
        <p class="tagline">A Match-3 Fair Game Prototype</p>
        <button class="btn btn-figma btn-figma-orange" id="btn-play">PLAY</button>
        <div class="level-picker">
          <button class="btn btn-ghost level-choice" data-level="0">Level 1 · Snack Shack</button>
          <button class="btn btn-ghost level-choice" data-level="1">Level 2 · Barnyard Bash</button>
        </div>
      </div>
    </div>
  </div>

  <!-- OBJECTIVES SCREEN — brief pre-level explainer. Only the button is functional. -->
  <div id="screen-objectives" class="screen-outer">
    <div class="screen">
      <div class="objectives-frame">
        <div class="objectives-bg"></div>
        <img class="objectives-spiral" src="assets/img/obj_spiral.svg" alt="" />
        <img class="objectives-food-title" src="assets/img/obj_food_title.svg" alt="FOOD" />
        <p class="objectives-level">OBJECTIVES</p>
        <p class="objectives-blurb" id="objectives-blurb">
          Score 1,400 points before the timer runs out! Match 3 or more matching treats — the bigger the combo, the bigger the bonus. Ice cream is worth double, so scoop it up! You've got 22 moves and 90 seconds to hit the goal.
        </p>

        <p class="objectives-row-label" style="top: 490px;">BONUS ITEM</p>
        <div class="figma-panel obj-moves-panel">
          <div class="figma-layer" style="inset:0;background-image:url(../assets/img/match_indicator.svg)"></div>
          <img class="moves-icon-img" src="assets/img/moves_icon.svg" alt="" />
          <span class="moves-value" id="objectives-bonus-multiplier">2X</span>
        </div>

        <p class="objectives-row-label" style="top: 641px;">SCORE GOAL</p>
        <div class="figma-panel obj-target-panel">
          <div class="figma-layer" style="top:8.05%;bottom:0;background-image:url(../assets/img/target_shadow.svg)"></div>
          <div class="figma-layer" style="top:0;bottom:8.05%;background-image:url(../assets/img/target_body.svg)"></div>
          <div class="figma-layer" style="top:22.75%;right:9.14%;bottom:30.79%;left:8.62%;background-image:url(../assets/img/target_track.svg)"></div>
          <span class="objectives-target-value" id="objectives-target">1,400</span>
        </div>

        <button class="btn btn-figma btn-figma-orange btn-objectives" id="btn-start-playing">START PLAYING</button>
      </div>
    </div>
  </div>

  <!-- GAME SCREEN -->
  <div id="screen-game" class="screen-outer hidden">
    <div class="screen">
      <div class="game-frame">

        <img class="fair-logo-img" src="assets/img/logo.svg" alt="THE FAIR" />

        <div class="figma-panel score-panel">
          <div class="figma-layer" style="top:6.37%;bottom:3.7%;background-image:url(../assets/img/score_shadow.svg)"></div>
          <div class="figma-layer" style="top:1.3%;bottom:8.77%;background-image:url(../assets/img/score_body.svg)"></div>
          <div class="score-header"><span class="score-header-label">TOTAL SCORE</span></div>
          <span class="score-value" id="ui-score">0</span>
        </div>

        <div class="figma-panel moves-panel">
          <div class="figma-layer" style="inset:0;background-image:url(../assets/img/match_indicator.svg)"></div>
          <img class="moves-icon-img" id="ui-moves-icon" src="assets/img/moves_icon.svg" alt="" />
          <span class="moves-value" id="ui-moves">20</span>
        </div>

        <div class="figma-panel time-panel">
          <div class="figma-layer" style="inset:0;background-image:url(../assets/img/time_indicator.svg)"></div>
          <span class="time-value" id="ui-timer">01:30</span>
        </div>

        <div class="figma-panel target-panel">
          <div class="figma-layer" style="top:8.05%;bottom:0;background-image:url(../assets/img/target_shadow.svg)"></div>
          <div class="figma-layer" style="top:0;bottom:8.05%;background-image:url(../assets/img/target_body.svg)"></div>
          <div class="figma-layer" style="top:22.75%;right:9.14%;bottom:30.79%;left:8.62%;background-image:url(../assets/img/target_track.svg)"></div>
          <div class="target-icon" id="ui-target-icon"></div>
          <div class="target-bar-track">
            <div class="target-bar-fill" id="ui-target-fill"></div>
            <span class="target-count" id="ui-target-count">0 / 500</span>
          </div>
        </div>

        <!-- BOARD AREA -->
        <div class="board-wrap">
          <div id="board" class="board"></div>
          <div id="combo-popup" class="combo-popup"></div>
        </div>

        <!-- END OVERLAY — Figma: Food Game Screen > Overlay > Panel: Level Complete (node 2077:10043) -->
        <div id="overlay-end" class="overlay hidden">
          <div class="end-card">
            <!-- No SVG <filter> here on purpose: SVG filter primitives force
                 the browser to rasterize whatever they're attached to, which
                 reintroduces the scale-softening bug even for inline markup.
                 The drop shadow is applied as CSS `filter: drop-shadow()`
                 instead (see .end-card-bg in styles.css), which doesn't. -->
            <svg class="end-card-bg" width="478" height="652" viewBox="0 0 478 652" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M238.997 651.985C169.407 651.985 99.8028 648.493 39.3034 641.509C23.1333 639.647 11.2315 628.138 10.5032 611.842C1.63146 415.606 -2.7097 101.472 1.80627 35.2837C2.50552 25.1278 15.9223 12.513 25.9594 10.7961C67.9871 3.59385 153.485 0 238.997 0C324.509 0 410.006 3.59385 452.034 10.7961C462.071 12.513 475.488 25.1424 476.187 35.2837C480.718 101.472 476.362 415.606 467.505 611.857C466.762 628.138 454.86 639.647 438.69 641.524C378.191 648.508 308.601 652 238.997 652V651.985Z" fill="url(#end-card-gradient)"/>
              <path d="M238.997 4C324.521 4.00001 409.706 7.6003 451.358 14.7383L451.359 14.7393C455.274 15.4089 460.429 18.4078 464.801 22.7266C469.216 27.0882 471.945 31.9133 472.196 35.5586C476.709 101.491 472.367 415.404 463.509 611.674C462.875 625.573 452.975 635.559 438.902 637.466L438.229 637.551C379.068 644.38 311.14 647.862 242.997 647.993V647.985H238.997C169.529 647.985 100.08 644.499 39.7617 637.536H39.7607C25.3353 635.875 15.1307 625.796 14.499 611.663V611.661C5.62653 415.407 1.29879 101.494 5.79688 35.5586C6.04837 31.9059 8.77774 27.0805 13.1914 22.7217C17.5619 18.4055 22.718 15.4091 26.6338 14.7393L26.6348 14.7383C68.2874 7.60029 153.473 4 238.997 4Z" stroke="#D1FFFC" stroke-width="8"/>
              <defs>
                <radialGradient id="end-card-gradient" cx="0" cy="0" r="1" gradientUnits="userSpaceOnUse" gradientTransform="translate(239 326) rotate(90) scale(326 239)">
                  <stop stop-color="#C3FFFC"/>
                  <stop offset="1" stop-color="#6DF7FF"/>
                </radialGradient>
              </defs>
            </svg>
            <h2 id="end-title">LEVEL COMPLETE!</h2>
            <p id="end-sub"></p>
            <p class="end-score-label">FINAL SCORE</p>
            <p class="end-score-value" id="end-score">0</p>
            <button class="btn-figma-lg btn-figma-lg-blue" id="btn-continue">
              <span>CONTINUE</span>
            </button>
            <button class="btn-figma-lg btn-figma-lg-orange" id="btn-retry">
              <span>TRY AGAIN</span>
            </button>
          </div>
        </div>

      </div>
    </div>
  </div>

</div>

<script src="js/assets.js?v=7"></script>
<script src="js/engine.js?v=2"></script>
<script src="js/audio.js?v=2"></script>
<script src="js/app.js?v=8"></script>
</body>
</html>
