/* ---------------- BOARD AREA ----------------
   board_shape.svg has an 8px centered stroke, so its own fill+stroke canvas
   (833.01x832.981) is larger than the "Board Shape" layer's nominal bbox
   (817.01x816.98) by exactly the stroke bleed — confirmed by the original
   Figma export coding that image at `inset: -0.98%` (0.98% * 817 ≈ 8px)
   relative to its layout box. Rendering the asset at its own native size,
   centered in the Board frame (473,62,835,831), reproduces that exactly
   instead of squeezing the stroke by stretching it into the smaller box. */
.board-wrap {
  position: absolute;
  left: 474px;
  top: 61px;
  width: 833.01px;
  height: 832.981px;
}

.board {
  width: 100%;
  height: 100%;
  display: grid;
  grid-template-columns: repeat(9, 85.54px);
  grid-template-rows: repeat(9, 85.46px);
  gap: 5px;
  /* Keeps the grid content (809.86x809.14) aligned to the Items frame's
     absolute position (483, 73.72) now that board-wrap moved to (474, 61). */
  padding: 12.72px 14.15px 11.12px 9px;
  background-image: url("../assets/img/board_shape.svg");
  background-size: 100% 100%;
  background-repeat: no-repeat;
}

.cell {
  position: relative;
}

/* The tile's own art (pizza.svg, corn.svg, hotdog.png, etc.) is already a
   complete rounded-card + icon graphic sized to the exact cell — it is the
   only container. Don't add a second background/shadow/inset around it. */
.tile {
  position: absolute;
  inset: 0;
  cursor: pointer;
  touch-action: none;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  transition: transform 0.12s ease, top 0.28s ease, left 0.28s ease, opacity 0.22s ease;
  user-select: none;
}

.tile svg, .tile img { width: 100%; height: 100%; pointer-events: none; }

/* star.svg's visible card is a sub-region of a larger padded canvas (room
   for the drop shadow) — crop to just that region instead of showing the
   whole padded canvas, which is what made it look smaller than other tiles.
   Card rect measured from the SVG path: x:[6.45,91.99] y:[10.66,96.12] in a
   102x104 canvas. Selector specificity intentionally beats ".tile img" above. */
.tile .tile-star-crop {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
}
.tile .tile-star-crop img {
  position: absolute;
  left: -7.54%;
  top: -12.47%;
  width: 119.24%;
  height: 121.70%;
}

/* Transient press/hold feedback — tied directly to the pointer being down
   on the tile (see onTilePointerDown/Up in app.js), not to game state. No
   border/outline, just a quick scale that reverts on release or drag. */
.tile.pressed {
  transform: scale(1.08);
  z-index: 5;
}

.tile.matched {
  animation: pop-out 0.28s ease forwards;
  z-index: 3;
}

.tile.falling-in {
  animation: drop-in 0.32s ease;
}

.tile.invalid-shake {
  animation: shake 0.32s ease;
}

@keyframes pop-out {
  0% { transform: scale(1); opacity: 1; }
  60% { transform: scale(1.25); opacity: 0.8; }
  100% { transform: scale(0); opacity: 0; }
}

@keyframes drop-in {
  0% { transform: translateY(-18px); opacity: 0.4; }
  100% { transform: translateY(0); opacity: 1; }
}

@keyframes shake {
  0%, 100% { transform: translateX(0); }
  25% { transform: translateX(-6px); }
  75% { transform: translateX(6px); }
}

/* ---------------- COMBO POPUP ---------------- */
.combo-popup {
  position: absolute;
  top: 40%;
  left: 50%;
  transform: translate(-50%, -50%) scale(0.6);
  font-family: 'Luckiest Guy', cursive;
  font-size: 46px;
  color: var(--gold);
  text-shadow: 3px 3px 0 #7a1f2b, 0 0 30px rgba(255,210,63,0.7);
  opacity: 0;
  pointer-events: none;
  white-space: nowrap;
  z-index: 20;
}

.combo-popup.show {
  animation: combo-pop 1.1s ease forwards;
}

@keyframes combo-pop {
  0% { opacity: 0; transform: translate(-50%, -50%) scale(0.4) rotate(-4deg); }
  20% { opacity: 1; transform: translate(-50%, -50%) scale(1.15) rotate(2deg); }
  35% { transform: translate(-50%, -50%) scale(1) rotate(0deg); }
  80% { opacity: 1; }
  100% { opacity: 0; transform: translate(-50%, -60%) scale(1.05); }
}

/* ---------------- END OVERLAY — Figma: Food Game Screen > Overlay >
   Panel: Level Complete (node 2077:10043, 478x652 at 444,186). Lives inside
   .game-frame so it scales with the same transform as the rest of the HUD. */
.overlay {
  position: absolute;
  inset: 0;
  background: rgba(10, 5, 20, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 50;
}

/* The card background is an INLINE <svg> (literal markup in index.html),
   not an <img src="...svg"> or CSS background-image. That distinction
   matters: an external image resource gets rasterized to a bitmap once,
   and this app's responsive transform:scale() then scales that bitmap —
   softening curves at non-1 scale factors (yesterday's bug). Inline SVG
   is live DOM content the browser repaints as vector geometry every time,
   so it can't suffer that — EXCEPT if an SVG <filter> is attached (they
   force rasterization of their input by spec, inline or not, which is
   exactly what reintroduced the softness a moment ago). So the shape+
   stroke paths here carry no SVG filter at all; the drop shadow below is
   CSS `filter: drop-shadow()`, which doesn't have that problem. */
.end-card {
  position: relative;
  width: 478px;
  height: 652px;
}
.end-card-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 478px;
  height: 652px;
  pointer-events: none;
  filter:
    drop-shadow(0 11px 0 #ffffff)
    drop-shadow(0 18px 30px rgba(0, 0, 0, 0.35));
}

#end-title {
  position: absolute;
  left: 50%;
  top: 79.45px;
  width: 300px;
  margin: 0;
  transform: translateX(-50%);
  font-family: 'Holtwood One SC', serif;
  color: #2168ff;
  font-size: 42px;
  line-height: 37px;
  text-align: center;
}

#end-sub {
