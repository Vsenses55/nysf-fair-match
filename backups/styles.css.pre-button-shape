}

/* Pure-CSS pill buttons — no image asset, same reasoning as .end-card
   above: a gradient + border-radius repaints crisply at any transform
   scale, where a rasterized shape+shine image asset can soften/stairstep. */
.btn-figma-lg {
  position: absolute;
  left: 50%;
  width: 320px;
  height: 86px;
  transform: translateX(-50%);
  padding: 0;
  border: none;
  border-radius: 999px;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #f5ece6;
  font-family: 'Holtwood One SC', serif;
  font-size: 19px;
  text-transform: uppercase;
  text-shadow: 0 1px 2px rgba(0,0,0,0.3);
}
.btn-figma-lg:active {
  transform: translateX(-50%) scale(0.97);
}
/* Stroke + shadow colors/offset pulled from the real exported button SVGs
   (btn_blue_shape_lg.svg / btn_orange_shape_lg.svg): each has its own
   separately-drawn stroke path (not just `stroke` on the fill) and an SVG
   filter whose feColorMatrix recolors the drop shadow — in both buttons
   that shadow color exactly matches the stroke color, dy=7, fully opaque
   (same "127 in feColorMatrix is just an intermediate mask" pattern as
   the panel). No clip-path on these yet (shape is still a plain pill,
   deferred), so a plain box-shadow inset ring is safe here — that's only
   unreliable in combination with clip-path, per the panel investigation.
   The outer shadow is CSS filter:drop-shadow, not box-shadow, on general
   principle (box-shadow can't do a hard 100%-opacity offset-only shadow
   as accurately, and this keeps both buttons consistent with the panel). */
.btn-figma-lg-blue {
  background: linear-gradient(180deg, #1d39e6 0%, #1d39e6 48%, #0828e6 49%, #0828e6 100%);
  box-shadow: inset 0 0 0 2px #0118e7;
  filter: drop-shadow(0 7px 0 #0118e7);
}
.btn-figma-lg-orange {
  background: linear-gradient(180deg, #ee5922 0%, #ee5922 48%, #f63319 49%, #f63319 100%);
  box-shadow: inset 0 0 0 2px #f62837;
  filter: drop-shadow(0 7px 0 #f62837);
}

