:root {
  --design-w: 1366px;
  --design-h: 1024px;
  --ink: #2c1c10;
  --gold: #ffd23f;
  --gold-dark: #e8a412;
  --fair-blue: #1c5fd6;
  --fair-blue-dark: #0d3d91;
  --fair-blue-light: #5aa8ff;
  --fair-green: #3fae5e;
}

* { box-sizing: border-box; }

html, body {
  margin: 0;
  padding: 0;
  height: 100%;
  background: #1b1230;
  color: var(--ink);
  font-family: 'Rowdies', sans-serif;
  overflow: hidden;
}

#app {
  width: 100%;
  height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.hidden { display: none !important; }

/* The whole game canvas is authored at the Figma design's native 1366x1024
   resolution so every child element below can use the exact px/percent
   values from the design. Responsive fit is done in JS (app.js: fitScreen)
   by resizing .screen-outer to the real on-screen size and applying a
   matching transform:scale to the fixed-size .screen inside it — a plain
   CSS transform doesn't change layout size, so scaling .screen directly
   would leave the browser thinking the page is still 1366px wide and
   fighting mobile viewport zoom. */
.screen-outer {
  position: relative;
  flex-shrink: 0;
  overflow: hidden;
}

.screen {
  width: var(--design-w);
  height: var(--design-h);
  transform-origin: top left;
  position: relative;
  background-image: url("../assets/img/bkg_fairground.jpg");
  background-size: cover;
  background-position: center;
}

/* ---------------- START SCREEN ---------------- */
.start-card {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  text-align: center;
  background: rgba(13, 61, 145, 0.72);
  border: 6px solid var(--gold);
  border-radius: 28px;
  padding: 56px 72px;
  box-shadow: 0 20px 60px rgba(0,0,0,0.5);
}

.logo-img {
  width: 260px;
  margin: 0 0 12px;
  filter: drop-shadow(0 6px 10px rgba(0,0,0,0.35));
}

.tagline {
  color: #d9c9ff;
  font-size: 15px;
  margin-bottom: 32px;
  letter-spacing: 1px;
}

.btn {
  font-family: 'Rowdies', sans-serif;
  font-weight: 700;
  font-size: 16px;
  border-radius: 14px;
  padding: 14px 36px;
  border: none;
  cursor: pointer;
  transition: transform 0.12s ease, box-shadow 0.12s ease;
  letter-spacing: 1px;
}
.btn:active { transform: scale(0.96); }

.btn-figma {
  position: relative;
  z-index: 0;
  width: 220px;
  height: 59px;
  padding: 0;
  background: transparent;
  border: none;
  border-radius: 0;
  overflow: visible;
  color: #f5ece6;
  font-family: 'Holtwood One SC', serif;
  font-size: 16px;
  display: flex;
  align-items: center;
  justify-content: center;
  text-shadow: 0 1px 2px rgba(0,0,0,0.3);
}
.btn-figma::before, .btn-figma::after {
  content: "";
  position: absolute;
  left: 0; right: 0;
  background-size: 100% 100%;
  background-repeat: no-repeat;
  pointer-events: none;
}
.btn-figma::before {
  top: -1%; bottom: -7%;
  z-index: -2;
}
.btn-figma::after {
  top: 1%; bottom: 43%;
  z-index: -1;
}
.btn-figma-orange::before { background-image: url("../assets/img/btn_orange_shape.svg"); }
.btn-figma-orange::after { background-image: url("../assets/img/btn_blue_shine.svg"); }

.btn-ghost {
  background: transparent;
  color: #e9dcff;
  border: 2px solid #6b4fa0;
}
.btn-ghost:hover { background: rgba(255,255,255,0.08); }
.btn-ghost.small { font-size: 12px; padding: 8px 16px; width: 100%; }

.level-picker {
  margin-top: 28px;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

