}

.end-score-label {
  position: absolute;
  left: 50%;
  top: 213.45px;
  width: 317px;
  margin: 0;
  transform: translateX(-50%);
  font-family: 'Rowdies', sans-serif;
  color: #4f6d9d;
  font-size: 26px;
  text-align: center;
}

.end-score-value {
  position: absolute;
  left: 50%;
  top: 249.45px;
  width: 317px;
  margin: 0;
  transform: translateX(-50%);
  font-family: 'Rowdies', sans-serif;
